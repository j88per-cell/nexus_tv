# SQLite database file (created on first run/migrate if it doesn't exist yet). Relative
# paths are resolved from wherever the backend process is started.
SQLITE_PATH=./data/nexus.sqlite3

# HTTP API
PORT=4100

# Media library root(s), comma-separated
MEDIA_ROOTS=/Movies

# Where Liquidsoap writes HLS segments; nginx serves this path at /streams/
HLS_ROOT=/opt/nexus/data/hls

# Where generated .liq files are written
LIQ_CONFIG_ROOT=/opt/nexus/data/liq

# Liquidsoap binary
LIQUIDSOAP_BIN=liquidsoap

# ffprobe binary
FFPROBE_BIN=ffprobe

# ffmpeg binary, used by the nightly proxy-generation job
FFMPEG_BIN=ffmpeg

# Where nightly-generated proxy (pre-encoded) copies are written, mirroring each source
# file's path relative to its media root. Fine to nest under a MEDIA_ROOTS entry (as the
# default does) — the scanner excludes this exact path from its walk so proxies don't get
# re-ingested as new source media.
PROXY_ROOT=/Movies/_proxies

# The nightly proxy job is time-bounded, not count-bounded — it keeps encoding until this
# many minutes have passed (leaves headroom within the Mon-Fri 1am-6am window for the
# scan/schedule steps either side of it) rather than a fixed file count, since a fixed count
# either wastes most of the window (movies) or risks overshooting it (unlucky long files).
PROXY_TIME_BUDGET_MINUTES=270
# Safety cap on files per run regardless of time budget (won't normally be hit).
PROXY_MAX_FILES=300
# How many files to encode at once. An RTX 3060 has no consumer NVENC session cap
# (confirmed: 4 concurrent encodes ran fine) — drop this to 1 if only CPU fallback is
# available, since concurrent CPU jobs compete for the same cores.
PROXY_CONCURRENCY=3

# Base of the Node API, used to build the URL liquidsoap polls for "next"
API_BASE_URL=http://localhost:4100

# Publicly reachable base URL (nginx), used to build stream links in the M3U playlist
PUBLIC_BASE_URL=http://nexus.home

# How many hours ahead each channel's schedule should be kept filled
SCHEDULE_HORIZON_HOURS=48

# Login used by Xtream Codes-compatible player apps (e.g. IPTV Smarters Pro).
# Single stock credential, not a real user system — change from the defaults.
XTREAM_USERNAME=nexus
XTREAM_PASSWORD=nexus
