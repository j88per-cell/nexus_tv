#!/usr/bin/liquidsoap
# Generated by Nexus for channel {{CHANNEL_NUMBER}} ({{CHANNEL_NAME}}) — do not edit by hand,
# edit the channel's rules/overrides in the Nexus admin UI and restart the channel instead.
#
# Note: source files vary in container/codec/resolution, so Liquidsoap must still encode the
# combined output to one consistent stream — this is normalizing/remuxing for continuity, not
# per-request "transcoding" of a whole library. Tune the video bitrate/preset below for the
# host's CPU budget once running several channels concurrently.

settings.log.level.set(3)
# Default canvas is 1280x720 regardless of source — most of this library is well below
# that (352p/480p rips), so encoding at the default means upscaling every frame for no
# benefit. Rendering at a lower canvas cuts encode cost substantially.
settings.frame.video.width.set(960)
settings.frame.video.height.set(540)

def next_track() =
  uri = process.read("curl -s '{{API_BASE_URL}}/api/channels/{{CHANNEL_ID}}/next-file'")
  uri = string.trim(uri)
  if uri != "" then
    request.create(uri)
  else
    null()
  end
end

radio = request.dynamic(next_track)
radio = mksafe(radio)

streams = [
  ("live", %ffmpeg(format="mpegts", %audio(codec="aac", b="128k"), %video(codec="libx264", b="1800k", preset="ultrafast", threads="4", g="150")))
]

output.file.hls(
  playlist="stream.m3u8",
  segment_duration=6.,
  segments=30,
  segments_overhead=15,
  "{{HLS_DIR}}",
  streams,
  radio
)
